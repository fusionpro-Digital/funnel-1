# Copy to .env.local for local development. Set the same variables in your
# hosting provider (Vercel: Project → Settings → Environment Variables).

# Required. API key from https://resend.com/api-keys. The contact form
# returns an error instead of sending while this is unset.
RESEND_API_KEY=

# Optional. Comma-separated inboxes that receive each lead.
# Defaults live in src/app/api/contact/route.ts.
CONTACT_RECIPIENT_EMAILS=

# Optional. The From address, on a domain verified in Resend.
# RESEND_FROM_EMAIL="FusionPro Digital <contact@fusionprodigital.com>"
RESEND_FROM_EMAIL=
